# ==============================================
# RolliSuite Environment Configuration
# ==============================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control
# ==============================================

# ---------------------------------------------
# Database
# ---------------------------------------------
DATABASE_URL="postgresql://rollisuite:password@localhost:5432/rollisuite?schema=public"
# For Docker: postgresql://rollisuite:password@postgres:5432/rollisuite?schema=public

# ---------------------------------------------
# Application
# ---------------------------------------------
NODE_ENV="development"
API_PORT=8001
WEB_PORT=3000
API_URL="http://localhost:8001"
WEB_URL="http://localhost:3000"

# ---------------------------------------------
# Authentication & Security
# ---------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="8h"
SESSION_TIMEOUT_MINUTES=480
BCRYPT_ROUNDS=10

# PIN Login
PIN_LOCKOUT_ATTEMPTS=5
PIN_LOCKOUT_DURATION_MINUTES=15

# IP Restriction (comma-separated list)
ALLOWED_OFFICE_IPS="127.0.0.1,::1,192.168.1.0/24"

# Proxy ID Encryption (AES-256-GCM)
PROXY_ID_ENCRYPTION_KEY="your-32-character-encryption-key-here-must-be-exactly-32-chars"

# ---------------------------------------------
# QuickBooks Online Integration
# ---------------------------------------------
QBO_CLIENT_ID="your-qbo-client-id"
QBO_CLIENT_SECRET="your-qbo-client-secret"
QBO_REALM_ID="your-qbo-realm-id"
QBO_WEBHOOK_VERIFIER_TOKEN="your-qbo-webhook-verifier-token"
QBO_ENVIRONMENT="sandbox"  # or "production"
QBO_REDIRECT_URI="http://localhost:8001/api/qbo/callback"

# ---------------------------------------------
# RolliWorking Integration
# ---------------------------------------------
ROLLIWORKING_API_KEY="your-rolliworking-api-key"
ROLLISUITE_API_KEY="your-rollisuite-api-key"
ROLLIWORKING_BASE_URL="https://pkgnrcfqrldwjibghefm.supabase.co/functions/v1"

# ---------------------------------------------
# Wix Integration
# ---------------------------------------------
WIX_WEBHOOK_SECRET="your-wix-webhook-secret"

# ---------------------------------------------
# Email (Resend)
# ---------------------------------------------
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="noreply@quotes.rolliworks.com"
EMAIL_REPLY_TO="help@rolliworks.com"

# ---------------------------------------------
# SMS (Twilio)
# ---------------------------------------------
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
SECURITY_ALERT_PHONE="+1234567890"
SECURITY_ALERT_CARRIER="verizon"  # or "att", "tmobile", etc.

# ---------------------------------------------
# Cloudflare R2 Storage
# ---------------------------------------------
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_BUCKET_NAME="rollisuite-photos"
R2_PUBLIC_URL="https://photos.rollisuite.com"

# ---------------------------------------------
# External Webhooks
# ---------------------------------------------
PARTS_WEBHOOK_API_KEY="your-parts-webhook-api-key"

# ---------------------------------------------
# Optional Integrations
# ---------------------------------------------
# AI Services (for docs-qa, signature comparison)
LOVABLE_API_KEY="your-lovable-api-key"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Cron Jobs
ENABLE_CRON_JOBS=true
RW_STATUS_CRON_SCHEDULE="0 5 * * *"  # 5 AM daily
MAINTENANCE_CRON_SCHEDULE="0 2 * * *"  # 2 AM daily
VAULT_STORAGE_CRON_SCHEDULE="0 3 * * *"  # 3 AM daily
GOLD_PRICE_CRON_SCHEDULE="0 */6 * * *"  # Every 6 hours

# ---------------------------------------------
# Public Domains
# ---------------------------------------------
PUBLIC_DOMAIN="upload.rolliworks.com"
SHORT_URL_DOMAIN="upload.rolliworks.com"

# ---------------------------------------------
# Redis (Optional - for caching & job queues)
# ---------------------------------------------
REDIS_URL="redis://localhost:6379"
# For Docker: redis://redis:6379

# ---------------------------------------------
# Logging
# ---------------------------------------------
LOG_LEVEL="info"  # debug, info, warn, error
ENABLE_QUERY_LOGGING=false
