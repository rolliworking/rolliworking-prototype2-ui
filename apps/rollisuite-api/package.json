    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "ioredis": "^5.3.2",
    "node-cron": "^3.0.3",
    "resend": "^3.2.0",
    "twilio": "^5.0.4",
    "zod": "^3.22.4"
