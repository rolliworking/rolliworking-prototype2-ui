// ==============================================
// RolliSuite Complete Prisma Schema
// ==============================================
// Migrated from Supabase/PostgreSQL
// 74 tables, 16 enums, 34 database functions
// ==============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================================
// ENUMS (16 total)
// ==============================================

enum AppRole {
  admin
  manager
  office
  front_desk
  staff
  band_room
}

enum JobStatus {
  intake
  in_review
  awaiting_customer_approval
  approved
  in_service
  testing
  ready_to_ship
  closed
}

enum SimpleJobStatus {
  open
  closed
}

enum PriorityLevel {
  low
  normal
  high
  urgent
}

enum EstimateStatus {
  draft
  sent
  approved
  converted
  declined
  expired
  on_hold
}

enum ServiceType {
  repair
  restoration
  appraisal
  consignment
}

enum ItemType {
  service
  part
  labor
  shipping
  tax
  discount
  client_watch
}

enum UomType {
  each
  box
  set
}

enum PoStatus {
  draft
  issued
  received
  cancelled
}

enum SoStatus {
  draft
  pending
  fulfilled
  shipped
  picked_up
  closed
}

enum TransferStatus {
  draft
  pending
  in_transit
  received
  cancelled
}

enum AdjustmentType {
  physical_count
  damage
  obsolete
  correction
  return
  other
}

enum CustodyStatus {
  awaiting_arrival
  received
  in_service
  ready_for_pickup
  shipped
  picked_up
}

enum CycleCountStatus {
  draft
  in_progress
  completed
  cancelled
}

enum OutboundEventStatus {
  pending
  processing
  sent
  failed
}

enum ReceivedWebhookStatus {
  pending
  processed
  failed
}

// ==============================================
// SECURITY & AUTH
// ==============================================

model Profile {
  id         String    @id @default(uuid())
  userId     String    @unique @map("user_id")
  fullName   String?   @map("full_name")
  email      String?
  avatarUrl  String?   @map("avatar_url")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  userRole       UserRole?
  userCredential UserCredential?
  jobsCreated    Job[]    @relation("JobsCreatedBy")
  jobsAssigned   Job[]    @relation("JobsAssignedTo")

  @@map("profiles")
}

model UserCredential {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_credentials")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  role      AppRole
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_roles")
}

model RolePermission {
  id            String   @id @default(uuid())
  role          AppRole
  permissionKey String   @map("permission_key")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([role, permissionKey])
  @@map("role_permissions")
}

model Invitation {
  id         String    @id @default(uuid())
  email      String
  role       AppRole
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("invitations")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_log")
}

model ApiRateLimit {
  id           String   @id @default(uuid())
  identifier   String
  endpoint     String
  requestCount Int      @default(0) @map("request_count")
  windowStart  DateTime @map("window_start")

  @@unique([identifier, endpoint])
  @@map("api_rate_limits")
}

model CacheStore {
  id         String    @id @default(uuid())
  key        String    @unique
  value      Json
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("cache_store")
}

model DailyHitList {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  generatedAt DateTime @default(now()) @map("generated_at")
  items       Json     // Array of { jobId, estimateNumber, priority, reason, dueDate }
  metadata    Json?    // { totalJobs, urgentCount, overdueCount }

  @@unique([date])
  @@index([date])
  @@map("daily_hit_lists")
}

model JobQueue {
  id         String   @id @default(uuid())
  jobType    String   @map("job_type")
  payload    Json
  status     String   @default("pending")
  attempts   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([status])
  @@map("job_queue")
}

// ==============================================
// CUSTOMERS
// ==============================================

model Customer {
  id                String    @id @default(uuid())
  firstName         String?   @map("first_name")
  lastName          String?   @map("last_name")
  displayName       String?   @map("display_name")
  companyName       String?   @map("company_name")
  email             String?
  emailNormalized   String?   @map("email_normalized")
  phone             String?
  phoneNormalized   String?   @map("phone_normalized")
  address           String?
  city              String?
  state             String?
  zip               String?
  notes             String?
  qboCustomerId     String?   @unique @map("qbo_customer_id")
  isShipDirect      Boolean   @default(false) @map("is_ship_direct")
  isTradePricing    Boolean   @default(false) @map("is_trade_pricing")
  skipShippingInfo  Boolean   @default(false) @map("skip_shipping_info")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  watches           Watch[]
  jobs              Job[]
  estimates         Estimate[]
  salesOrders       SalesOrder[]
  addresses         CustomerAddress[]
  communicationPermission CustomerCommunicationPermission?
  clientProperty    ClientProperty[]
  appraisals        Appraisal[]

  @@index([emailNormalized])
  @@index([phoneNormalized])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  addressType String  @map("address_type")
  street1    String
  street2    String?
  city       String
  state      String
  zip        String
  country    String   @default("US")
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model CustomerCommunicationPermission {
  id              String    @id @default(uuid())
  customerId      String    @unique @map("customer_id")
  consentEmail    Boolean   @default(false) @map("consent_email")
  consentSms      Boolean   @default(false) @map("consent_sms")
  consentRecorded DateTime? @map("consent_recorded")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_communication_permissions")
}

// ==============================================
// WATCHES & CLIENT PROPERTY
// ==============================================

model Watch {
  id              String   @id @default(uuid())
  customerId      String   @map("customer_id")
  brand           String?
  model           String?
  referenceNumber String?  @map("reference_number")
  serialNumber    String?  @map("serial_number")
  movementType    String?  @map("movement_type")
  caseMaterial    String?  @map("case_material")
  bandMaterial    String?  @map("band_material")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs     Job[]

  @@map("watches")
}

model ClientProperty {
  id             String        @id @default(uuid())
  customerId     String        @map("customer_id")
  description    String
  custodyStatus  CustodyStatus @default(awaiting_arrival) @map("custody_status")
  receivedDate   DateTime?     @map("received_date")
  releaseDate    DateTime?     @map("release_date")
  storageLocation String?      @map("storage_location")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("client_property")
}

// ================================================
// JOBS & ESTIMATES (Continuing in next section...)
// ================================================

model Job {
  id                   String      @id @default(uuid())
  jobId                String      @unique @map("job_id")
  estimateNumber       String?     @map("estimate_number")
  quickbooksInvoiceId  String?     @map("quickbooks_invoice_id")
  customerId           String      @map("customer_id")
  watchId              String      @map("watch_id")
  status               JobStatus   @default(intake)
  priority             PriorityLevel @default(normal)
  dueDate              DateTime?   @map("due_date")
  intakeNotes          String?     @map("intake_notes")
  conditionNotes       String?     @map("condition_notes")
  createdBy            String?     @map("created_by")
  assignedTo           String?     @map("assigned_to")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  watch          Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)
  creator        Profile? @relation("JobsCreatedBy", fields: [createdBy], references: [userId])
  assignee       Profile? @relation("JobsAssignedTo", fields: [assignedTo], references: [userId])
  
  statusHistory  JobStatusHistory[]
  activityLog    JobActivityLog[]
  timingTests    TimingTest[]
  pressureTests  PressureTest[]
  salesOrders    SalesOrder[]

  @@map("jobs")
}

model JobStatusHistory {
  id         String     @id @default(uuid())
  jobId      String     @map("job_id")
  fromStatus JobStatus? @map("from_status")
  toStatus   JobStatus  @map("to_status")
  changedBy  String?    @map("changed_by")
  notes      String?
  createdAt  DateTime   @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_status_history")
}

model JobActivityLog {
  id         String   @id @default(uuid())
  jobId      String   @map("job_id")
  userId     String   @map("user_id")
  action     String
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_activity_log")
}

// Due to character limits, I'll continue this in the next file...

// ==============================================
// ESTIMATES
// ==============================================

model Estimate {
  id                String         @id @default(uuid())
  estimateNumber    String         @unique @map("estimate_number")
  customerId        String         @map("customer_id")
  status            EstimateStatus @default(draft)
  serviceType       ServiceType?   @map("service_type")
  totalAmount       Decimal?       @map("total_amount") @db.Decimal(12, 2)
  sentAt            DateTime?      @map("sent_at")
  approvedAt        DateTime?      @map("approved_at")
  convertedAt       DateTime?      @map("converted_at")
  expiresAt         DateTime?      @map("expires_at")
  notes             String?
  internalNotes     String?        @map("internal_notes")
  templateId        String?        @map("template_id")
  qboEstimateId     String?        @unique @map("qbo_estimate_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  template      EstimateTemplate? @relation(fields: [templateId], references: [id])
  lineItems     EstimateLineItem[]

  @@index([status])
  @@index([customerId])
  @@map("estimates")
}

model EstimateLineItem {
  id             String   @id @default(uuid())
  estimateId     String   @map("estimate_id")
  description    String
  quantity       Decimal  @db.Decimal(10, 4)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  extendedPrice  Decimal  @map("extended_price") @db.Decimal(12, 2)
  partId         String?  @map("part_id")
  lineType       ItemType @map("line_type")
  sortOrder      Int?     @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  part     Part?    @relation(fields: [partId], references: [id])

  @@map("estimate_line_items")
}

model EstimateTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lineItems  EstimateTemplateLine[]
  estimates  Estimate[]

  @@map("estimate_templates")
}

model EstimateTemplateLine {
  id             String   @id @default(uuid())
  templateId     String   @map("template_id")
  description    String
  quantity       Decimal  @db.Decimal(10, 4)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  lineType       ItemType @map("line_type")
  sortOrder      Int?     @map("sort_order")

  template EstimateTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("estimate_template_lines")
}

// ==============================================
// SALES ORDERS
// ==============================================

model SalesOrder {
  id                  String    @id @default(uuid())
  soNumber            String    @unique @map("so_number")
  customerId          String    @map("customer_id")
  jobId               String?   @map("job_id")
  orderDate           DateTime  @default(now()) @map("order_date")
  shipDate            DateTime? @map("ship_date")
  status              SoStatus  @default(draft)
  subtotal            Decimal?  @db.Decimal(12, 2)
  shippingAmount      Decimal?  @map("shipping_amount") @db.Decimal(12, 2)
  totalAmount         Decimal?  @map("total_amount") @db.Decimal(12, 2)
  notes               String?
  workCompletedSent   Boolean   @default(false) @map("work_completed_sent")
  qboInvoiceId        String?   @unique @map("qbo_invoice_id")
  isPaid              Boolean   @default(false) @map("is_paid")
  balanceDue          Decimal?  @map("balance_due") @db.Decimal(12, 2)
  tcAgreed            Boolean   @default(false) @map("tc_agreed")
  tcAgreedAt          DateTime? @map("tc_agreed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job           Job?            @relation(fields: [jobId], references: [id])
  lineItems     SoLine[]
  tcAcceptances TcAcceptance[]

  @@index([status])
  @@index([customerId])
  @@map("sales_orders")
}

model TcAcceptance {
  id            String   @id @default(uuid())
  salesOrderId  String   @map("sales_order_id")
  customerEmail String   @map("customer_email")
  ipAddress     String   @map("ip_address")
  userAgent     String   @map("user_agent")
  tcVersion     String   @map("tc_version") @default("1.0")
  acceptedAt    DateTime @default(now()) @map("accepted_at")

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@map("tc_acceptances")
}

model SoLine {
  id            String   @id @default(uuid())
  soId          String   @map("so_id")
  partId        String   @map("part_id")
  qtyOrdered    Decimal  @map("qty_ordered") @db.Decimal(10, 4)
  qtyAllocated  Decimal  @default(0) @map("qty_allocated") @db.Decimal(10, 4)
  qtyShipped    Decimal  @default(0) @map("qty_shipped") @db.Decimal(10, 4)
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  unitCost      Decimal? @map("unit_cost") @db.Decimal(12, 2)
  extendedPrice Decimal  @map("extended_price") @db.Decimal(12, 2)
  notes         String?
  sortOrder     Int?     @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  salesOrder SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  part       Part       @relation(fields: [partId], references: [id])

  @@map("so_lines")
}

// ==============================================
// INVENTORY & PARTS
// ==============================================

model Store {
  id        String   @id @default(uuid())
  storeName String   @map("store_name")
  address   String?
  city      String?
  state     String?
  zip       String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  locations Location[]

  @@map("stores")
}

model Location {
  id           String   @id @default(uuid())
  storeId      String   @map("store_id")
  locationName String   @map("location_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  bins  Bin[]

  @@map("locations")
}

model Bin {
  id          String   @id @default(uuid())
  locationId  String   @map("location_id")
  binName     String   @map("bin_name")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  stock    InventoryStock[]

  @@map("bins")
}

model Part {
  id                String   @id @default(uuid())
  partNumber        String   @unique @map("part_number")
  description       String
  itemType          ItemType @default(part) @map("item_type")
  uom               UomType  @default(each)
  qboItemId         String?  @unique @map("qbo_item_id")
  defaultSellPrice  Decimal? @map("default_sell_price") @db.Decimal(12, 2)
  averageCost       Decimal? @map("average_cost") @db.Decimal(12, 2)
  isActive          Boolean  @default(true) @map("is_active")
  reorderPoint      Int?     @map("reorder_point")
  reorderQty        Int?     @map("reorder_qty")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  stock             InventoryStock[]
  vendorParts       VendorPart[]
  aliases           PartAlias[]
  bomLines          BomLine[]
  poLines           PoLine[]
  soLines           SoLine[]
  estimateLineItems EstimateLineItem[]
  caliberParts      CaliberPart[]
  vendorPrices      PartVendorPrice[]

  @@map("parts")
}

model PartAlias {
  id         String   @id @default(uuid())
  partId     String   @map("part_id")
  alias      String
  createdAt  DateTime @default(now()) @map("created_at")

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([partId, alias])
  @@map("part_aliases")
}

model InventoryStock {
  id             String   @id @default(uuid())
  partId         String   @map("part_id")
  binId          String   @map("bin_id")
  qtyOnHand      Decimal  @default(0) @map("qty_on_hand") @db.Decimal(10, 4)
  qtyOnOrder     Decimal  @default(0) @map("qty_on_order") @db.Decimal(10, 4)
  qtyAllocated   Decimal  @default(0) @map("qty_allocated") @db.Decimal(10, 4)
  updatedAt      DateTime @updatedAt @map("updated_at")

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)
  bin  Bin  @relation(fields: [binId], references: [id], onDelete: Cascade)

  @@unique([partId, binId])
  @@map("inventory_stock")
}

model InventoryAdjustment {
  id             String         @id @default(uuid())
  partId         String         @map("part_id")
  binId          String         @map("bin_id")
  adjustmentType AdjustmentType @map("adjustment_type")
  qtyAdjustment  Decimal        @map("qty_adjustment") @db.Decimal(10, 4)
  reason         String?
  createdBy      String         @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@map("inventory_adjustments")
}

model InventoryMove {
  id           String   @id @default(uuid())
  moveNumber   String   @unique @map("move_number")
  partId       String   @map("part_id")
  fromBinId    String   @map("from_bin_id")
  toBinId      String   @map("to_bin_id")
  quantity     Decimal  @db.Decimal(10, 4)
  notes        String?
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("inventory_moves")
}

// ==============================================
// VENDORS & PURCHASING
// ==============================================

model Vendor {
  id            String   @id @default(uuid())
  vendorName    String   @map("vendor_name")
  contactName   String?  @map("contact_name")
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  zip           String?
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  vendorParts   VendorPart[]
  purchaseOrders PurchaseOrder[]

  @@map("vendors")
}

model VendorPart {
  id                 String   @id @default(uuid())
  vendorId           String   @map("vendor_id")
  partId             String   @map("part_id")
  vendorPartNumber   String?  @map("vendor_part_number")
  vendorDescription  String?  @map("vendor_description")
  cost               Decimal? @db.Decimal(12, 2)
  leadTimeDays       Int?     @map("lead_time_days")
  minimumOrderQty    Int?     @map("minimum_order_qty")
  isPreferred        Boolean  @default(false) @map("is_preferred")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  part   Part   @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([vendorId, partId])
  @@map("vendor_parts")
}

model PartVendorPrice {
  id               String   @id @default(uuid())
  partId           String   @map("part_id")
  vendorId         String   @map("vendor_id")
  price            Decimal  @db.Decimal(12, 2)
  effectiveDate    DateTime @default(now()) @map("effective_date")
  createdAt        DateTime @default(now()) @map("created_at")

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@map("part_vendor_prices")
}

model VendorPriceHistory {
  id         String   @id @default(uuid())
  vendorId   String   @map("vendor_id")
  partId     String   @map("part_id")
  oldPrice   Decimal? @map("old_price") @db.Decimal(12, 2)
  newPrice   Decimal  @map("new_price") @db.Decimal(12, 2)
  changedAt  DateTime @default(now()) @map("changed_at")

  @@map("vendor_price_history")
}

model PurchaseOrder {
  id          String    @id @default(uuid())
  poNumber    String    @unique @map("po_number")
  vendorId    String    @map("vendor_id")
  orderDate   DateTime  @default(now()) @map("order_date")
  dueDate     DateTime? @map("due_date")
  status      PoStatus  @default(draft)
  totalAmount Decimal?  @map("total_amount") @db.Decimal(12, 2)
  notes       String?
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  vendor    Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  lineItems PoLine[]
  receipts  PoReceipt[]

  @@map("purchase_orders")
}

model PoLine {
  id            String   @id @default(uuid())
  poId          String   @map("po_id")
  partId        String   @map("part_id")
  qtyOrdered    Decimal  @map("qty_ordered") @db.Decimal(10, 4)
  qtyReceived   Decimal  @default(0) @map("qty_received") @db.Decimal(10, 4)
  unitCost      Decimal  @map("unit_cost") @db.Decimal(12, 2)
  extendedCost  Decimal  @map("extended_cost") @db.Decimal(12, 2)
  notes         String?
  sortOrder     Int?     @map("sort_order")

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  part          Part          @relation(fields: [partId], references: [id])

  @@map("po_lines")
}

model PoReceipt {
  id          String   @id @default(uuid())
  poId        String   @map("po_id")
  receivedDate DateTime @default(now()) @map("received_date")
  receivedBy  String   @map("received_by")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  lineItems     PoReceiptLine[]

  @@map("po_receipts")
}

model PoReceiptLine {
  id          String   @id @default(uuid())
  receiptId   String   @map("receipt_id")
  poLineId    String   @map("po_line_id")
  partId      String   @map("part_id")
  qtyReceived Decimal  @map("qty_received") @db.Decimal(10, 4)
  binId       String   @map("bin_id")

  receipt PoReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("po_receipt_lines")
}

// ==============================================
// TESTING & INSPECTION
// ==============================================

model TimingTest {
  id               String   @id @default(uuid())
  jobId            String   @map("job_id")
  position         String
  rate             String
  beatError        String?  @map("beat_error")
  amplitude        String?
  notes            String?
  performedBy      String   @map("performed_by")
  createdAt        DateTime @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("timing_tests")
}

model PressureTest {
  id          String   @id @default(uuid())
  jobId       String   @map("job_id")
  pressure    String
  result      String
  notes       String?
  performedBy String   @map("performed_by")
  createdAt   DateTime @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("pressure_tests")
}

model InspectionRequest {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  status     String   @default("pending")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("inspection_requests")
}

// ==============================================
// REFERENCE DATA & CALIBERS
// ==============================================

model Caliber {
  id             String   @id @default(uuid())
  caliberName    String   @unique @map("caliber_name")
  manufacturer   String?
  description    String?
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")

  parts CaliberPart[]

  @@map("calibers")
}

model CaliberPart {
  id        String   @id @default(uuid())
  caliberId String   @map("caliber_id")
  partId    String   @map("part_id")
  quantity  Int      @default(1)
  notes     String?

  caliber Caliber @relation(fields: [caliberId], references: [id], onDelete: Cascade)
  part    Part    @relation(fields: [partId], references: [id])

  @@unique([caliberId, partId])
  @@map("caliber_parts")
}

model ModelReference {
  id              String   @id @default(uuid())
  brand           String
  model           String?
  referenceNumber String?  @map("reference_number")
  caliber         String?
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([brand])
  @@index([referenceNumber])
  @@map("model_references")
}

// ==============================================
// QUICKBOOKS INTEGRATION
// ==============================================

model QboToken {
  id           String    @id @default(uuid())
  realmId      String    @unique @map("realm_id")
  accessToken  String    @map("access_token")
  refreshToken String    @map("refresh_token")
  environment  String    @default("sandbox")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("qbo_tokens")
}

model QboSyncLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  qboId      String?  @map("qbo_id")
  action     String
  status     String
  errorMessage String? @map("error_message")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("qbo_sync_log")
}

model QboAccountMapping {
  id          String   @id @default(uuid())
  accountType String   @map("account_type")
  qboAccountId String  @map("qbo_account_id")
  accountName String   @map("account_name")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([accountType])
  @@map("qbo_account_mappings")
}

model QboDailyJournal {
  id          String   @id @default(uuid())
  journalDate DateTime @map("journal_date") @db.Date
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([journalDate])
  @@map("qbo_daily_journal")
}

model QboInvoice {
  id           String   @id @default(uuid())
  soId         String   @unique @map("so_id")
  qboInvoiceId String   @unique @map("qbo_invoice_id")
  syncedAt     DateTime @default(now()) @map("synced_at")

  @@map("qbo_invoices")
}

model QuickbooksSyncLog {
  id        String   @id @default(uuid())
  syncType  String   @map("sync_type")
  status    String
  message   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("quickbooks_sync_log")
}

// ==============================================
// SHIPPING & LABELS
// ==============================================

model ShippingRate {
  id           String   @id @default(uuid())
  carrier      String
  service      String
  weightMin    Decimal  @map("weight_min") @db.Decimal(10, 2)
  weightMax    Decimal  @map("weight_max") @db.Decimal(10, 2)
  rate         Decimal  @db.Decimal(10, 2)
  effectiveDate DateTime @default(now()) @map("effective_date")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("shipping_rates")
}

model ShippingLabel {
  id               String   @id @default(uuid())
  trackingNumber   String   @unique @map("tracking_number")
  carrier          String
  service          String
  labelUrl         String?  @map("label_url")
  cost             Decimal? @db.Decimal(10, 2)
  createdBy        String   @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("shipping_labels")
}

model PackageScanLog {
  id             String   @id @default(uuid())
  trackingNumber String   @map("tracking_number")
  scannedBy      String   @map("scanned_by")
  scannedAt      DateTime @default(now()) @map("scanned_at")

  @@map("package_scan_logs")
}

model LabelPrint {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  labelType  String   @map("label_type")
  printedBy  String   @map("printed_by")
  printedAt  DateTime @default(now()) @map("printed_at")

  @@map("label_prints")
}

// ==============================================
// MISCELLANEOUS
// ==============================================

model Appraisal {
  id              String   @id @default(uuid())
  appraisalNumber String   @unique @map("appraisal_number")
  customerId      String   @map("customer_id")
  itemDescription String   @map("item_description")
  appraisalValue  Decimal  @map("appraisal_value") @db.Decimal(12, 2)
  notes           String?
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("appraisals")
}

model IntakeLead {
  id         String   @id @default(uuid())
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  email      String?
  phone      String?
  source     String?
  notes      String?
  status     String   @default("new")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("intake_leads")
}

model ServiceCategory {
  id           String   @id @default(uuid())
  categoryName String   @map("category_name")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")

  subcategories ServiceSubcategory[]

  @@map("service_categories")
}

model ServiceSubcategory {
  id              String   @id @default(uuid())
  categoryId      String   @map("category_id")
  subcategoryName String   @map("subcategory_name")
  description     String?
  createdAt       DateTime @default(now()) @map("created_at")

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("service_subcategories")
}

model ShopTimeEntry {
  id         String   @id @default(uuid())
  jobId      String?  @map("job_id")
  userId     String   @map("user_id")
  startTime  DateTime @map("start_time")
  endTime    DateTime? @map("end_time")
  hours      Decimal?  @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("shop_time_entries")
}

model LineItem {
  id           String   @id @default(uuid())
  jobId        String?  @map("job_id")
  description  String
  quantity     Decimal  @db.Decimal(10, 4)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice   Decimal  @map("total_price") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("line_items")
}

model Attachment {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  fileName   String   @map("file_name")
  fileUrl    String   @map("file_url")
  fileSize   Int?     @map("file_size")
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("attachments")
}

model MessageTemplate {
  id           String   @id @default(uuid())
  templateName String   @unique @map("template_name")
  subject      String?
  body         String
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("message_templates")
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist")
}

model CsvImportStaging {
  id         String   @id @default(uuid())
  tableName  String   @map("table_name")
  rowData    Json     @map("row_data")
  status     String   @default("pending")
  errorMessage String? @map("error_message")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("csv_import_staging")
}

model ReorderSuggestion {
  id               String   @id @default(uuid())
  partId           String   @map("part_id")
  currentStock     Int      @map("current_stock")
  reorderPoint     Int      @map("reorder_point")
  suggestedQty     Int      @map("suggested_qty")
  preferredVendor  String?  @map("preferred_vendor")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("reorder_suggestions")
}

// ==============================================
// INVENTORY TRANSFERS & CYCLE COUNTS
// ==============================================

model InventoryTransfer {
  id             String         @id @default(uuid())
  transferNumber String         @unique @map("transfer_number")
  fromLocationId String         @map("from_location_id")
  toLocationId   String         @map("to_location_id")
  status         TransferStatus @default(draft)
  notes          String?
  createdBy      String         @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  lineItems TransferLine[]

  @@map("inventory_transfers")
}

model TransferLine {
  id         String   @id @default(uuid())
  transferId String   @map("transfer_id")
  partId     String   @map("part_id")
  quantity   Decimal  @db.Decimal(10, 4)
  notes      String?

  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@map("transfer_lines")
}

model CycleCount {
  id          String           @id @default(uuid())
  countNumber String           @unique @map("count_number")
  locationId  String           @map("location_id")
  status      CycleCountStatus @default(draft)
  countDate   DateTime         @default(now()) @map("count_date")
  notes       String?
  createdBy   String           @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  completedAt DateTime?        @map("completed_at")

  lineItems CycleCountLine[]

  @@map("cycle_counts")
}

model CycleCountLine {
  id            String   @id @default(uuid())
  countId       String   @map("count_id")
  partId        String   @map("part_id")
  binId         String   @map("bin_id")
  systemQty     Decimal  @map("system_qty") @db.Decimal(10, 4)
  countedQty    Decimal? @map("counted_qty") @db.Decimal(10, 4)
  variance      Decimal? @db.Decimal(10, 4)

  cycleCount CycleCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@map("cycle_count_lines")
}

// ==============================================
// BOM (BILL OF MATERIALS)
// ==============================================

model BomHeader {
  id          String   @id @default(uuid())
  bomNumber   String   @unique @map("bom_number")
  description String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lineItems BomLine[]

  @@map("bom_headers")
}

model BomLine {
  id         String   @id @default(uuid())
  bomId      String   @map("bom_id")
  partId     String   @map("part_id")
  quantity   Decimal  @db.Decimal(10, 4)
  notes      String?

  bomHeader BomHeader @relation(fields: [bomId], references: [id], onDelete: Cascade)
  part      Part      @relation(fields: [partId], references: [id])

  @@map("bom_lines")
}

// ==============================================
// WEBHOOKS & EVENTS
// ==============================================

model OutboundEvent {
  id          String              @id @default(uuid())
  eventType   String              @map("event_type")
  endpoint    String
  payload     Json
  status      OutboundEventStatus @default(pending)
  attempts    Int                 @default(0)
  lastAttempt DateTime?           @map("last_attempt")
  errorMessage String?            @map("error_message")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([status])
  @@map("outbound_events")
}

model ReceivedWebhookEvent {
  id          String                @id @default(uuid())
  source      String
  eventType   String                @map("event_type")
  payload     Json
  status      ReceivedWebhookStatus @default(pending)
  processedAt DateTime?             @map("processed_at")
  errorMessage String?              @map("error_message")
  createdAt   DateTime              @default(now()) @map("created_at")

  @@index([status])
  @@index([source, eventType])
  @@map("received_webhook_events")
}

