{
  "name": "rollisuite-emergent",
  "version": "1.0.0",
  "private": true,
  "description": "RolliSuite ERP - Complete watch repair shop management system",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn dev:api\" \"yarn dev:web\"",
    "dev:api": "yarn workspace @rollisuite/api dev",
    "dev:web": "yarn workspace @rollisuite/web dev",
    "build": "yarn workspaces foreach -A run build",
    "build:api": "yarn workspace @rollisuite/api build",
    "build:web": "yarn workspace @rollisuite/web build",
    "prisma:generate": "yarn workspace @rollisuite/api prisma:generate",
    "prisma:migrate": "yarn workspace @rollisuite/api prisma:migrate",
    "prisma:studio": "yarn workspace @rollisuite/api prisma:studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "lint": "yarn workspaces foreach -A run lint",
    "type-check": "yarn workspaces foreach -A run type-check"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=4.0.0"
  },
  "packageManager": "yarn@4.1.1"
}
